{
  "name": "mail-counter",
  "version": "0.1.0",
  "description": "Chrome extension that shows unread Gmail counts for several accounts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "icons": "bun scripts/icons.ts",
    "keygen": "bun scripts/keygen.ts",
    "typecheck": "bun check",
    "ci": "bun check && bun lint && bun fmt --check && bun test && bun scripts/build.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/chrome": "^0.3.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
